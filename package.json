{
  "name": "nichodevs",
  "version": "1.0.0",
  "private": true,
  "description": "Estúdio de áudio no navegador com voz, guitarra e MIXMASTER, mais plugins VST3 para Windows e Linux, em visual retrô de 8 bits.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/validate-site.js",
    "test:e2e": "playwright test",
    "test": "node --test tests/validate-site.test.js",
    "preview:community": "node scripts/preview-community.js",
    "test:preview": "playwright test --config=playwright.preview.config.js",
    "test:community": "node --test community/tests/*.test.js",
    "start:community": "node community/server.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24"
  }
}
